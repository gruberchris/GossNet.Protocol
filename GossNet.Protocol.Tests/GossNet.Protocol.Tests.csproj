<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 is compile-verified by the library build; it is not an executable TFM. -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <!--
          MSTest 4 runs on Microsoft.Testing.Platform rather than VSTest, so the test
          assembly is a self-hosting executable and Microsoft.NET.Test.Sdk is no longer
          needed. `dotnet test` is pointed at the new runner by /dotnet.config.
        -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
        <!--
          Lets the net8.0 test host start on a newer runtime when the .NET 8 runtime
          isn't installed locally. CI installs the real .NET 8 runtime so that TFM is
          exercised on its own runtime there.
        -->
        <RollForward>Major</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GossNet.Protocol\GossNet.Protocol.csproj" />
    </ItemGroup>

</Project>
