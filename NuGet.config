<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github" value="https://nuget.pkg.github.com/gruberchris/index.json" />
    </packageSources>
    <!--
      Central Package Management requires explicit source mapping when more than one
      source is configured (NU1507). Everything resolves from nuget.org; only
      GossNet.* packages may come from the GitHub Packages feed.
    -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="GossNet.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
