<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Google.Cloud.Compute.V1 ships netstandard2.0 and net462 assets, so this
             provider covers the same frameworks as GossNet.Protocol itself. -->
        <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Cloud.Compute.V1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GossNet.Protocol\GossNet.Protocol.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GossNet.Discovery.Tests"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageId>GossNet.Discovery.Gcp</PackageId>
        <Authors>Chris Gruber</Authors>
        <Description>Google Cloud Compute Engine label-based node discovery for GossNet.Protocol.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/gruberchris/GossNet.Protocol</PackageProjectUrl>
        <RepositoryUrl>https://github.com/gruberchris/GossNet.Protocol</RepositoryUrl>
        <PackageTags>gossip;network;protocol;gcp;google-cloud;compute-engine;service-discovery</PackageTags>
    </PropertyGroup>
</Project>
